---
import Layout from "../layouts/Layout.astro";
import ExperiencePage from "../components/3d/ExperiencePage.tsx";
---

<Layout title="Marcelo Schreiber | Portfolio">
  <script is:inline>
    if (window.innerWidth < 800) {
      window.location.replace("/html");
    }
  </script>
  <ExperiencePage client:only="react" />
</Layout>

<style is:global>
  html,
  body,
  #root {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;

    background: #081930ff; /* fallback for old browsers */
    background: linear-gradient(to bottom, #081930ff 0%, #071629 100%);
  }
  .r3f {
    touch-action: none;
  }

  .htmlScreen iframe {
    width: 1016px;
    height: 705px;
    border: none;
    border-radius: 25px;
    background-color: #000000;
    display: block;
    backface-visibility: hidden;
    transform: translateZ(0);
    transform-style: preserve-3d;
    will-change: transform;
  }
</style>
