---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Project {
  title: string;
  meta: string;
  letter: string;
  href: string;
  art: string;
  image?: ImageMetadata;
}
interface Props {
  copy: Record<string, string>;
  projects: Project[];
}

const { copy, projects } = Astro.props;
const eyebrow = "text-[13px] font-bold tracking-[.15em] text-[#8e493e] uppercase";
---

<section id="work" class="bg-[#eee9df] px-[10%] py-15 text-[#222833] dark:bg-[#0f2232] dark:text-[#f3f7fb] max-[760px]:px-6 max-[760px]:py-11.25">
  <div class="mb-6.25 flex items-end justify-between">
    <div>
      <span class={eyebrow}>{copy.selectedWork}</span>
      <h2 class="mt-2 font-serif text-[29px] tracking-tighter text-[#222833] dark:text-[#f3f7fb]">{copy.workHeading}</h2>
    </div>
    <a href="#work" target="_blank" rel="noreferrer" aria-label="View all work" class="grid size-9 place-items-center rounded-full border border-[#deddd9] bg-white text-[#69717b] dark:border-[#527891] dark:bg-[#1c3b51] dark:text-[#f3f7fb]"><ArrowRight size={17} /></a>
  </div>
  <div class="grid grid-cols-3 gap-3.5 max-[760px]:grid-cols-1">
    {projects.map((project) => (
      <a href={project.href} target="_blank" rel="noreferrer" class="block p-0 text-left">
        <div class:list={["relative grid min-h-55 place-items-center overflow-hidden rounded-xs border border-[rgba(35,52,78,.2)] before:absolute before:size-37.5 before:rounded-full before:border before:border-white/65 before:transform-[rotate(25deg)_scaleX(1.6)] before:content-['']", project.art]}>
          {project.image ? (
            <Image src={project.image} alt={`${project.title} preview`} class="absolute inset-0 size-full object-cover" />
          ) : (
            <div class="rotate-[-8px] font-serif text-[52px] font-bold text-white [text-shadow:0_8px_18px_#0002]">{project.letter}</div>
          )}
          <span class="absolute top-3 right-3 grid size-6.75 place-items-center rounded-full bg-[#ffffff99] text-[#243149]"><ArrowRight size={13} /></span>
        </div>
        <div class="flex justify-between gap-2 px-px py-3.25">
          <div>
            <h3 class="font-serif text-[16px] text-[#2c323a] dark:text-[#f3f7fb]">{project.title}</h3>
            <p class="my-1 text-[16px] leading-[1.65] text-[#989ba0] dark:text-[#b9d0de]">{project.meta}</p>
          </div>
          <span class="flex items-center gap-1 pt-1 text-[10px] whitespace-nowrap text-[#8c8f94] dark:text-[#b9d0de]">View <ArrowRight size={13} /></span>
        </div>
      </a>
    ))}
  </div>
</section>
